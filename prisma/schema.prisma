

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  dormant
  suspended
}

enum Gender {
  male
  female
  others
}

enum ReservationType {
  booked
  reserve
}

enum PaymentStatus {
  paid
  pending
  cancel
}

enum PaymentMethod {
  cash
  credit_card
  khqr
  leave
}

enum Status {
  active
  disactive
}

model Role {
  role_id Int    @id @default(autoincrement())
  name    String @unique
  status   Status  @default(active)

  auths Auth[]
}

model State {
  state_id  Int @id @default(autoincrement())
  state_name  String  @unique
  status   Status  @default(active)

  cities   City[]
  employees    Employeeinfo[]
  customers    Customer[]
}

model City {
  city_id  Int @id  @default(autoincrement())
  state_id  Int
  city_name   String   
  status   Status  @default(active)

  @@unique([city_name, state_id])
  state  State  @relation(fields: [state_id], references: [state_id])
  employees    Employeeinfo[]
  customers    Customer[]
}

model Auth {
  auth_id      Int   @id @default(autoincrement())
  email        String   @unique
  password     String
  role_id      Int?
  employee_id  Int?     @unique
  customer_id  Int?     @unique
  status      AccountStatus     @default(active)
  created_at   DateTime @default(now())

  role      Role?     @relation(fields: [role_id], references: [role_id])
  employee  Employee? @relation(fields: [employee_id], references: [employee_id])
  customer  Customer? @relation(fields: [customer_id], references: [customer_id])
  cart   Cart[]
  logs   AuthLog[]
}

model Attendance {
  attendance_id Int @id @default(autoincrement())
  employee_id Int
  datetime DateTime @default(now())
  note String?
  status   Status  @default(active)

  employee Employee @relation(fields: [employee_id], references: [employee_id])
}

model Employee {
  employee_id    Int      @id @default(autoincrement())
  employee_code  String?  @unique
  first_name     String
  last_name      String
  gender         Gender   @default(male)
  dob            DateTime?
  phone          String?  @unique
  position_id    Int?
  department_id  Int?
  salary         Decimal  @db.Decimal(10,2)
  hired_date     DateTime?
  status Status @default(active)
  created_at     DateTime @default(now())

  auth      Auth?
  info      Employeeinfo?
  position  Position? @relation(fields: [position_id], references: [position_id])
  department Department? @relation(fields: [department_id], references: [department_id])
  reservedetails   Reservedetail[]
  sales    Sale[]
  shift     Shift[]
  attendances Attendance[]
  groupchat   Groupmessage[]
  payment  Payment[]
}

model Employeeinfo  {
  employeeinfo_id     Int     @id @default(autoincrement()) 
  employee_id    Int      @unique
  picture        String?
  region      String?
  email          String?  @unique
  address        String?
  city_id           Int
  state_id          Int
  country     String?
  note      String?
  status   Status  @default(active)

  employee Employee @relation(fields: [employee_id], references: [employee_id])
  state  State  @relation(fields: [state_id], references: [state_id])
  city    City  @relation(fields: [city_id], references: [city_id])
}

model Department {
  department_id   Int      @id @default(autoincrement())
  department_name String?
  department_code String?
  memo            String?
  status     Status    @default(active)
  created_at      DateTime @default(now())

  positions Position[]
  employees Employee[]
}

model Position {
  position_id   Int      @id @default(autoincrement())
  department_id Int
  position_name String?
  position_code String?
  memo          String?
  status      Status     @default(active)
  created_at    DateTime @default(now())

  department Department @relation(fields: [department_id], references: [department_id])
  employees   Employee[]
}

model Customer {
  customer_id    Int      @id @default(autoincrement())
  first_name     String
  last_name      String
  picture        String?
  gender         Gender   @default(male)
  email          String?  @unique
  phone          String?
  address        String?
  city_id           Int
  state_id          Int
  status      Status     @default(active)
  created_at     DateTime @default(now())

  state  State  @relation(fields: [state_id], references: [state_id])
  city    City  @relation(fields: [city_id], references: [city_id])
  auth    Auth?
  sales    Sale[]
  reservedetails Reservedetail[]
}

model Reservedetail {
  reservedetail_id Int    @id @default(autoincrement())
  room_id           Int
  employee_id       Int
  customer_id       Int?
  reservation_id    Int
  price             Decimal @db.Decimal(10,2)   
  night             Int
  amount            Decimal @db.Decimal(10,2)
  status   Status  @default(active)

  room      Room     @relation(fields: [room_id], references: [room_id])
  employee  Employee @relation(fields: [employee_id], references: [employee_id])
  customer  Customer? @relation(fields: [customer_id], references: [customer_id])
  reservation Reservation @relation(fields: [reservation_id], references: [reservation_id])
}

model Reservation {
  reservation_id  Int   @id @default(autoincrement())
  checkin_date    DateTime
  checkout_date   DateTime
  is_checkin      Boolean
  is_checkout     Boolean
  reservation_type ReservationType @default(reserve)
  adults          Int     @default(1)
  children        Int     @default(0)
  payment_status  PaymentStatus @default(paid)
  payment_method  PaymentMethod @default(cash)
  memo            String?
  status      Status     @default(active)

  details Reservedetail[]
  payment   Payment[]
}

model Room {
  room_id       Int      @id @default(autoincrement())
  roomtype_id     Int?
  room_name     String?
  price         Decimal  @db.Decimal(10,2)
  is_ac         Boolean  @default(true)
  capacity      Int      @default(4)
  size          Int      @default(25)
  discount_rate Int      @default(0)
  is_booked     Boolean  @default(false)
  status      Status     @default(active)
  created_at    DateTime @default(now())

  roomtype    Roomtype?    @relation(fields: [roomtype_id], references: [roomtype_id])
  pictures Roompicture[]
  reservedetails  Reservedetail[]
  sales    Sale[]
}

model Roomtype {
  roomtype_id      Int    @id    @default(autoincrement())
  type_name     String    @unique
  type_code     String    @unique
  status   Status  @default(active)

  rooms   Room[]
}

model Roompicture {
  roompicture_id Int      @id @default(autoincrement())
  room_id         Int
  picture         String
  created_at      DateTime @default(now())
  status   Status  @default(active)

  room Room @relation(fields: [room_id], references: [room_id])
}

model Product {
  product_id        Int      @id @default(autoincrement())
  product_name      String
  product_code      String?  
  category_id Int?
  picture           String?  
  price             Decimal  @db.Decimal(10,2)  @default(0.00)
  discount_rate     Int      @default(0)
  status      Status     @default(active)
  created_at         DateTime @default(now())

  category  Category? @relation(fields: [category_id], references: [category_id])
  stocks    Productstock[]
  saledetails      Saledetail[]
  cart   Cart[]
}

model Category {
  category_id Int      @id @default(autoincrement())
  picture             String?  
  category_name       String
  category_code       String?
  memo                String?  
  status      Status     @default(active)
  created_at           DateTime @default(now())

  products    Product[]
}

model Cart {
  cart_id    Int   @id   @default(autoincrement())
  auth_id   Int
  product_id     Int   
  quantity   Int 
  status   Status  @default(active)
  created_at    DateTime    @default(now())

  product   Product  @relation(fields: [product_id], references: [product_id])
  auth   Auth  @relation(fields: [auth_id], references: [auth_id])
  note  Cartnote[]
}

model Cartnote {
  cartnote_id   Int   @id    @default(autoincrement())
  cart_id   Int
  note   String
  status   Status  @default(active)

  cart  Cart   @relation(fields: [cart_id], references: [cart_id])
}

model Productstock {
  productstock_id Int      @id @default(autoincrement())
  product_id       Int?
  supplier_id      Int?
  inv_number       String?
  product_add      Int      @default(0)
  add_price        Decimal   @db.Decimal(12,2)  @default(0.00)
  add_date         DateTime?
  memo             String?
  status      Status     @default(active)
  created_at        DateTime @default(now())

  product    Product?     @relation(fields: [product_id], references: [product_id])
  supplier     Supplier?    @relation(fields: [supplier_id], references: [supplier_id])
}

model Supplier {
  supplier_id   Int      @id @default(autoincrement())
  supplier_name String
  company_name  String?
  phone         String?
  email         String?
  address       String?
  status      Status     @default(active)
  created_at     DateTime @default(now())

  stocks     Productstock[]
}

model Sale {
  sale_id       Int      @id @default(autoincrement())
  employee_id   Int
  room_id       Int?
  customer_id   Int?
  sale_date     DateTime    @default(now())
  amount        Decimal   @db.Decimal(12,2)
  status      Status     @default(active)
  created_at     DateTime @default(now())

  room     Room?    @relation(fields: [room_id], references: [room_id])
  employee    Employee      @relation(fields: [employee_id], references: [employee_id])
  customer    Customer?   @relation(fields: [customer_id], references: [customer_id])
  saledetails     Saledetail[]
  payment   Payment[]
}

model Saledetail {
  saledetail_id Int      @id @default(autoincrement())
  sale_id        Int
  product_id     Int
  quantity       Int
  amount         Decimal   @db.Decimal(12,2)
  status   Status  @default(active)
  created_at      DateTime @default(now())

  sale Sale @relation(fields: [sale_id], references: [sale_id])
  product    Product  @relation(fields: [product_id], references: [product_id])
}

model Payment {
  payment_id    Int   @id     @default(autoincrement())
  employee_id Int 
  sale_id   Int?   
  reservation_id   Int?
  invoice   String?
  hash  String
  fromAccountId   String
  toAccountId   String 
  currency   String
  amount    Decimal   @db.Decimal(12,2)
  externalRef  String
  status      Status     @default(active)
  created_at    DateTime  @default(now())

  sale   Sale?    @relation(fields: [sale_id], references: [sale_id])
  reservation    Reservation?    @relation(fields: [reservation_id], references: [reservation_id])
  employee   Employee     @relation(fields: [employee_id], references: [employee_id])
}

model Shift {
  shift_id        Int      @id @default(autoincrement())
  employee_id     Int?
  shift_code      String
  open_khmer_riel Decimal   @db.Decimal(12,2)  @default(0.00)
  open_us_dollar  Decimal   @db.Decimal(12,2)  @default(0.00)
  open_time       DateTime    @default(now())
  close_khmer_riel Decimal?  @db.Decimal(12,2)  @default(0.00)
  close_us_dollar  Decimal?  @db.Decimal(12,2)  @default(0.00)
  close_time      DateTime?   
  status      Status     @default(active)
  created_at      DateTime @default(now())

  banknotes    Banknote[]
  employee    Employee?   @relation(fields: [employee_id], references: [employee_id])
}


model Banknote {
  banknote_id Int @id @default(autoincrement())
  shift_id    Int
  khmer_100    Int? @default(0)
  khmer_500    Int? @default(0)
  khmer_1K     Int? @default(0)
  khmer_2K     Int? @default(0)
  khmer_5K     Int? @default(0)
  khmer_10K    Int? @default(0)
  khmer_15K    Int? @default(0)
  khmer_20K    Int? @default(0)
  khmer_30K    Int? @default(0)
  khmer_50K    Int? @default(0)
  khmer_100K   Int? @default(0)
  khmer_200K   Int? @default(0)
  us_1         Int? @default(0)
  us_5         Int? @default(0)
  us_10        Int? @default(0)
  us_20        Int? @default(0)
  us_50        Int? @default(0)
  us_100       Int? @default(0)
  status      Status     @default(active)
  created_at    DateTime @default(now())

  shift  Shift   @relation(fields: [shift_id], references: [shift_id])
}

model Groupmessage {
  groupmessage_id     Int @id @default(autoincrement())
  employee_id   Int? 
  content  String
  time  DateTime
  status   Status  @default(active)
  created_at   DateTime   @default(now())

  employee    Employee?   @relation(fields: [employee_id], references: [employee_id])
}

// ! Log
model Log {
  id         Int      @id @default(autoincrement())
  method     String
  url        String
  status     Int
  response_time Float
  ip         String
  user_agent String?
  created_at DateTime @default(now())
}

model AuthLog {
  id         Int      @id @default(autoincrement())
  auth_id  Int
  method     String
  url        String
  status     Int
  response_time Float
  ip         String
  user_agent String?
  created_at DateTime @default(now())

  auth  Auth   @relation(fields: [auth_id], references: [auth_id])
}


// ! test model
model Image {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  createdAt DateTime @default(now())
}